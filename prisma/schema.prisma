generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Proprietario {
  id                  Int          @id @default(autoincrement())
  nomeCompleto        String
  email               String       @unique
  telefone            String?
  cpf                 String
  cnpj                String
  nomeImobiliaria     String?
  enderecoImobiliaria String?
  senha               String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  accounts            Account[]
  sessions            Session[]
  imoveis             Imovel[]     @relation("ProprietarioImoveis") // Correção: Nome do relacionamento
}

model Imovel {
  id             Int       @id @default(autoincrement())
  nomeImovel     String
  tipoPropriedade String
  rua            String?   // Temporariamente opcional
  numero         String?   // Temporariamente opcional
  cep            String?   // Temporariamente opcional
  bairro         String?   // Temporariamente opcional
  cidade         String?   // Temporariamente opcional
  tamanho        String
  proprietarioId Int

  proprietario   Proprietario @relation("ProprietarioImoveis", fields: [proprietarioId], references: [id])
  inquilinos     Inquilino[]  

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}


model Inquilino {
  id              Int       @id @default(autoincrement())
  nome            String
  email           String    @unique
  telefone        String?
  cpf             String    @unique
  dataNascimento  DateTime
  senha           String
  isFirstLogin    Boolean   @default(true)

  imovel          Imovel?   @relation(fields: [imovelId], references: [id]) 
  imovelId        Int?      

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Account {
  id                 Int          @id @default(autoincrement())
  userId             Int
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user Proprietario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int          @id @default(autoincrement())
  sessionToken String       @unique
  userId       Int
  expires      DateTime

  user Proprietario @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         Int          @id @default(autoincrement())
  identifier String
  token      String       @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Funcionario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  telefone  String?
  senha     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
